#!/usr/bin/env bash
#
# pre-commit hook (kernel + criu rebase worktrees).
#
# Runs checkpatch --strict on the staged C/header diff and blocks the commit
# unless it is FULLY clean (0 errors, 0 warnings, 0 checks).
#
# checkpatch is resolved from this repo (scripts/checkpatch.pl) if present,
# otherwise from the kernel repo at /opt/builds/linux (used by criu).
#
# Bypass with:  git commit --no-verify
#
set -u

ROOT="$(git rev-parse --show-toplevel)"

if [ -x "$ROOT/scripts/checkpatch.pl" ]; then
	CHECKPATCH="$ROOT/scripts/checkpatch.pl"
	TREE_ARGS=(--root="$ROOT")
else
	CHECKPATCH="/opt/builds/linux/scripts/checkpatch.pl"
	TREE_ARGS=(--no-tree)
fi

if [ ! -x "$CHECKPATCH" ]; then
	echo "pre-commit: checkpatch.pl not found ($CHECKPATCH); skipping." >&2
	exit 0
fi

# Staged code files only (skip docs/plans/etc.).
mapfile -t FILES < <(git diff --cached --name-only --diff-filter=ACMR -- '*.c' '*.h' '*.S')
[ "${#FILES[@]}" -eq 0 ] && exit 0

diff_tmp="$(mktemp)"
trap 'rm -f "$diff_tmp"' EXIT
git diff --cached -- "${FILES[@]}" > "$diff_tmp"
[ -s "$diff_tmp" ] || exit 0

report="$("$CHECKPATCH" --strict --no-signoff --ignore=FILE_PATH_CHANGES "${TREE_ARGS[@]}" - < "$diff_tmp" 2>&1)"
rc=$?

total_line="$(printf '%s\n' "$report" | grep -E '^total: [0-9]' | tail -1)"
if [ -n "$total_line" ]; then
	e="$(printf '%s' "$total_line" | sed -n 's/^total: \([0-9]\{1,\}\) errors.*/\1/p')"
	w="$(printf '%s' "$total_line" | sed -n 's/^total: [0-9]\{1,\} errors, \([0-9]\{1,\}\) warnings.*/\1/p')"
	c="$(printf '%s' "$total_line" | sed -n 's/.*, \([0-9]\{1,\}\) checks,.*/\1/p')"
	e=${e:-0}; w=${w:-0}; c=${c:-0}
	if [ "$e" -gt 0 ] || [ "$w" -gt 0 ] || [ "$c" -gt 0 ]; then
		printf '%s\n' "$report" >&2
		echo >&2
		echo "pre-commit: checkpatch not clean ($e errors, $w warnings, $c checks)." >&2
		echo "Fix the issues, or bypass with: git commit --no-verify" >&2
		exit 1
	fi
	exit 0
fi

# No parseable summary: defer to checkpatch's own exit status.
if [ "$rc" -ne 0 ]; then
	printf '%s\n' "$report" >&2
	echo "pre-commit: checkpatch failed (rc=$rc). Bypass with: git commit --no-verify" >&2
	exit 1
fi
exit 0
